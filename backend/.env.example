# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173

# Relational Database (PostgreSQL)
# If PostgreSQL is unavailable locally, the backend automatically uses persistent SQLite at ./data/reachinbox.sqlite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler

# Redis (BullMQ Queue & Distributed Rate Limit Counters)
REDIS_URL=redis://127.0.0.1:6379

# Elasticsearch (Email Indexing & Search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Scheduler & Rate Limiting Configuration (Required by Assignment)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Ethereal Email Default SMTP (Optional - backend also auto-provisions Ethereal test accounts per sender)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slack OAuth 2.0 Configuration (For Live Rate-Limit Hit Notifications)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
SLACK_DEFAULT_WEBHOOK_URL=

